{
  "name": "2dpw",
  "private": true,
  "version": "0.0.1",
  "description": "2D Perfect World (PWI 1.3.6 gameplay) - personal test project",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev -w @2dpw/server\" \"npm:dev -w @2dpw/client\"",
    "start": "tsx packages/server/src/main.ts",
    "convert": "tsx tools/flare-convert/cli.ts",
    "build": "npm run build -w @2dpw/client",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/client && tsc -p tools",
    "test": "vitest run",
    "lint": "eslint .",
    "smoke": "bash tools/smoke.sh",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
